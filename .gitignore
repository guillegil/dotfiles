# AGS — regenerated by `ags types`, never commit
config/ags/@girs/
config/ags/node_modules/

# install.sh backups
.dotfiles-backup/

# SDD skill-registry caches (regenerated by sdd-init)
.atl/*.cache.json

# Python bytecode — regenerated whenever a skill script (e.g. ui-ux-pro-max) runs
__pycache__/
*.pyc

# secrets
*.env



# personal wallpaper (per-machine; hyprpaper falls back to background_color)
config/hypr/wallpaper.jpg
config/hypr/wallpaper.png
